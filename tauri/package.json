{
  "name": "manabi-cert-prep-tauri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "tauri": "tauri",
    "build:desktop": "node scripts/tauri-build.mjs build --no-bundle",
    "build:desktop:debug": "node scripts/tauri-build.mjs build --debug --no-bundle",
    "build:android": "node scripts/tauri-build.mjs android build --debug --apk --target aarch64",
    "build:android:x86": "node scripts/tauri-build.mjs android build --debug --apk --target x86_64"
  },
  "devDependencies": {
    "@tauri-apps/cli": "3.0.0-alpha.6"
  }
}
